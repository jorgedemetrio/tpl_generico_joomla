{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "generico",
  "version": "1.0.2",
  "description": "Assets for the tpl_generico template.",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "tpl_generico.css",
      "type": "style",
      "uri": "template.css",
      "dependencies": [
        "bootstrap.css",
        "fontawesome",
        "bootstrap-icons"
      ]
    },
    {
      "name": "tpl_generico.js",
      "type": "script",
      "uri": "template.js",
      "dependencies": [
        "core"
      ],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "tpl_generico.preset",
      "type": "preset",
      "dependencies": [
        "tpl_generico.css#style",
        "tpl_generico.js#script",
        "jquery#script"
      ]
    },
    {
      "name": "tpl_generico.offline",
      "type": "style",
      "uri": "offline.css",
      "dependencies": [
        "bootstrap.css"
      ]
    },
    {
      "name": "fontawesome",
      "type": "style",
      "uri": "system/joomla-fontawesome.min.css"
    },
    {
      "name": "bootstrap-icons",
      "type": "style",
      "uri": "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css",
      "attributes": {
        "integrity": "sha384-CK2SzKma4jA5H/MXDUU7i1TqZlCFaD4T01vtyDFvPlD97JQyS+IsSh1nI2EFbpyk",
        "crossorigin": "anonymous"
      }
    },
    {
      "name": "bootstrap.css",
      "type": "style",
      "uri": "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css",
      "attributes": {
        "integrity": "sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB",
        "crossorigin": "anonymous"
      }
    },
    {
      "name": "bootstrap.css.grid",
      "type": "style",
      "uri": "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap-grid.min.css",
      "dependencies": [
        "bootstrap.css"
      ],
      "attributes": {
        "integrity": "sha384-VIeCCV0aVHr99fkXDSmzLRuJhJWQXe4bDXs6hgg6w6zOTbtAWr8RqSNWu4a2ef9p",
        "crossorigin": "anonymous"
      }
    },
    {
      "name": "jquery",
      "type": "script",
      "uri": "https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js",
      "attributes": {
        "integrity": "sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs",
        "crossorigin": "anonymous"
      }
    }
  ]
}
